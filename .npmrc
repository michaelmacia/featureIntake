# Backyard's published 1.0.0 packages declare peer ranges (>=2.9.0) that only their private
# 2.x builds satisfy, and npm overrides don't reliably apply to peer ranges. Skip peer
# resolution for this project; react, react-dom and styled-components are listed explicitly
# in package.json so nothing relies on automatic peer installation. See ADR-008.
legacy-peer-deps=true
